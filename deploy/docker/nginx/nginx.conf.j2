events {}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_names_hash_bucket_size 64;

    # All sites live in sites-enabled:
    # - deerpost.conf (cpcx: deerpost.cx + emf.deerpost.cx) is rendered by
    #   playbooks/redeploy_landing_page.yml from deerpost-site.conf.j2
    # - the rest are managed by the chiguire-vps Ansible project
    #   (~/workspaces/chiguire-vps/ansible)
    include /etc/nginx/sites-enabled/*.conf;
}
