# Copy to .env and fill in values before running docker compose

# Postgres
POSTGRES_DB=cpcx
POSTGRES_USER=cpcx
POSTGRES_PASSWORD=changeme          # required — no default
POSTGRES_DATA_PATH=~/postgres       # host path for postgres data volume
DATA_PROTECTION_KEYS_PATH=~/dataprotection-keys   # host path for ASP.NET Data Protection key ring

# cpcx app
CPCX_PROJECT_PATH=cpcx              # path to the .csproj dir, relative to repo root
