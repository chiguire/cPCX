ARG PROJECT_PATH=cpcx

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder
ARG PROJECT_PATH
WORKDIR /src
COPY . .
RUN dotnet publish ${PROJECT_PATH} -c Release -o /app

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine
WORKDIR /app
COPY --from=builder /app .
RUN apk add --no-cache icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
# Run as the image's built-in non-root user (APP_UID=1654 in .NET 8+ images).
# Installs above ran as root; nothing below needs it. The /keys volume must be
# owned by this uid - redeploy_cpcx.yml takes care of that.
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "cpcx.dll"]
